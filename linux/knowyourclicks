#!/usr/bin/env python3
"""KnowYourClicks CLI and Desktop Application executable for Linux."""

import os
import sys
import time
import subprocess
import webbrowser
from pathlib import Path

# Add src to python path
ROOT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT_DIR))

from src.daemon import start_daemon, stop_daemon, daemon_status, get_running_pid
from src.config import DEFAULT_PORT, DEFAULT_HOST, DATA_DIR
from src.db import Database


def print_usage():
    print("""
KnowYourClicks - Privacy-First Keystroke & Typing Speed Analytics (Linux)

Usage:
    knowyourclicks <command> [options]
    or
    ./knowyourclicks <command> [options]

Commands:
    app         Launch native desktop application window (starts daemon if needed)
                Options:
                  --browser   Open dashboard in web browser instead of desktop window
    start       Start the background daemon process
    stop        Stop the running background daemon process
    restart     Restart the background daemon process
    status      Show background daemon and hardware listener status
    stats       Print summary of local keystroke statistics in terminal
    help        Show this help message
""")


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("help", "-h", "--help"):
        print_usage()
        sys.exit(0)

    cmd = sys.argv[1].lower()

    if cmd == "start":
        foreground = "--foreground" in sys.argv or "-f" in sys.argv
        start_daemon(foreground=foreground)

    elif cmd == "stop":
        stop_daemon()

    elif cmd == "restart":
        stop_daemon()
        start_daemon()

    elif cmd == "status":
        daemon_status()

    elif cmd == "app":
        pid = get_running_pid()
        if not pid:
            print("[KnowYourClicks] Starting background service...")
            start_daemon(foreground=False)
            time.sleep(0.5)

        url = f"http://{DEFAULT_HOST}:{DEFAULT_PORT}/"

        if "--browser" in sys.argv:
            print(f"[KnowYourClicks] Opening Dashboard in browser at {url}...")
            try:
                subprocess.run(["xdg-open", url], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                webbrowser.open(url)
        else:
            print(f"[KnowYourClicks] Launching native Linux desktop application...")
            from src.ui_app import launch_native_window
            launch_native_window(url)

    elif cmd == "stats":
        db = Database()
        s = db.get_statistics("1d")
        print("\n--- KnowYourClicks: Last 24 Hours Statistics ---")
        print(f"Total Whitelisted Keystrokes: {s['total_keys']}")
        print(f"Spacebar Presses:             {s['spaces']}")
        print(f"Edits (Backspace/Delete):     {s['edits']}")
        print(f"Correction Rate:              {s['correction_rate']}%")
        print(f"Punctuation Marks:            {s['punctuations']}")
        print(f"Local Storage:                {DATA_DIR}\n")
        print("Top Whitelisted Keys:")
        for k in s['key_counts'][:5]:
            print(f"  • {k['key_name']}: {k['total']}")
        print("------------------------------------------------\n")

    else:
        print(f"Unknown command: '{cmd}'")
        print_usage()
        sys.exit(1)


if __name__ == "__main__":
    main()
